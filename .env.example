# Prisma — pooled for the app (lib/db.ts), direct for migrations (prisma.config.ts).
# Default values below point at the local Docker Postgres from docker-compose.yml,
# so a fresh clone works with zero edits. The real project database is Supabase;
# see "Supabase" below and plans/261110-1334-supabase-vercel-deploy-migration/plan.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecom?sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ecom?sslmode=disable"

# --- Supabase (the shared project database) ---
# Copy both strings from Supabase dashboard -> Connect. Use the SHARED POOLER for
# both, never the direct connection (db.<ref>.supabase.co is IPv6-only on the free
# tier; the IPv4 add-on is paid and not used here):
#
#   DATABASE_URL  -> pooler TRANSACTION mode, port 6543  (app runtime)
#   DIRECT_URL    -> pooler SESSION mode,     port 5432  (prisma migrate / CLI)
#
# Pooler username is postgres.<project-ref>, not postgres. URL-encode the password.
#
# GOTCHA: DATABASE_URL needs `?uselibpqcompat=true&sslmode=require`. node-postgres
# >= 8.23 made plain `sslmode=require` do full certificate verification, which
# fails against the pooler's self-signed CA chain ("self-signed certificate in
# certificate chain"). `uselibpqcompat=true` restores libpq semantics (encrypt,
# don't verify) — the same thing psql does with sslmode=require. DIRECT_URL is
# consumed by the Prisma CLI and works with plain `?sslmode=require`.

# Supabase database password. NOT read by any code — the password must be embedded
# in the two URLs above. Kept here only as the source value for rebuilding them.
DATABASE_PASSWORD=

# App base URL — used for Origin checks and VNPay return URL
APP_URL=http://localhost:3000

# Better Auth
# Dev-only placeholder so a fresh clone works with zero manual edits — this
# value is committed and public, so it protects nothing. Generate a real one
# (`openssl rand -base64 32`) for anything beyond local/course-demo use.
BETTER_AUTH_SECRET=uF9FaTBULP6ThqM2wAEL/X703ghL6AGxXVHXPL6gJY4=
BETTER_AUTH_URL=http://localhost:3000

# VNPay sandbox
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/payments/vnpay/return

# Vercel Blob (admin image upload) — required from Sprint 2
BLOB_READ_WRITE_TOKEN=

# Optional
CRON_SECRET=
NEXT_PUBLIC_GA_ID=
RESEND_API_KEY=
